{
  "compilerOptions": {
    "target": "ES2025",
    "module": "commonjs",
    "rootDir": "./src",
    "outDir": "./out",
    "sourceMap": true,
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "declaration": true
  }
}